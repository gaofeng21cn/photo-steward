{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "photo-steward",
    "version": "0.4.16",
    "intent": "app",
    "name": {
      "zh-CN": "Photo Steward",
      "en-US": "Photo Steward"
    },
    "summary": {
      "zh-CN": "以 iCloud Photos 为主源，安全规划、审阅并执行照片镜像。",
      "en-US": "Safely plan, review, and apply photo mirrors from iCloud Photos."
    },
    "routing_summary": {
      "zh-CN": "查看 iCloud 照片镜像状态，审阅并执行照片镜像计划。",
      "en-US": "Review iCloud photo mirror status and apply reviewed plans."
    },
    "publisher": "gaofeng21cn",
    "icon": "assets/branding/photo-steward-logo.png",
    "repository": "https://github.com/gaofeng21cn/photo-steward"
  },
  "dependencies": {
    "opl_base": "^2.0.0"
  },
  "provides": {
    "skills": [
      {
        "id": "photo-steward",
        "path": "./skills/photo-steward",
        "exposure": "default"
      }
    ],
    "module_ids": [
      "photo.steward.v1"
    ],
    "cli_bin": [
      {
        "name": "photo-steward",
        "path": "./scripts/icloud-photo-sync"
      },
      {
        "name": "icloud-photo-sync",
        "path": "./scripts/icloud-photo-sync"
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "python3",
        "./scripts/app_contribution.py"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "photo.steward.plan",
          "view_type": "approval_diff",
          "slot": "settings.section",
          "settings_destination": "services",
          "sort_order": 300,
          "title": {
            "zh-CN": "照片镜像计划",
            "en-US": "Photo mirror plan"
          },
          "data_ref": "photo.steward.v1#plan",
          "empty_state": {
            "zh-CN": "没有待审核的照片镜像计划",
            "en-US": "No photo mirror plan is awaiting review"
          },
          "actions": [
            {
              "id": "photo.steward.apply",
              "label": {
                "zh-CN": "执行已审核计划",
                "en-US": "Apply reviewed plan"
              },
              "action_ref": "photo.steward.v1#plan.apply",
              "confirm": true
            }
          ]
        },
        {
          "id": "photo.steward.status",
          "view_type": "service_status",
          "slot": "settings.section",
          "settings_destination": "services",
          "sort_order": 301,
          "title": {
            "zh-CN": "照片同步状态",
            "en-US": "Photo sync status"
          },
          "data_ref": "photo.steward.v1#status",
          "empty_state": {
            "zh-CN": "尚未读取 Photo Steward 状态",
            "en-US": "Photo Steward status has not been read"
          }
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/photo-steward",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false
    }
  }
}

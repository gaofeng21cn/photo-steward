{
  "strategy": "daily_patch",
  "prepare": [
    [
      "python3",
      "scripts/materialize_package.py"
    ]
  ],
  "verify": [
    [
      "python3",
      "scripts/materialize_package.py",
      "--check"
    ]
  ],
  "release_paths": [
    "app/PhotoCenterMenuBar"
  ],
  "version_files": [
    {
      "path": "pyproject.toml",
      "kind": "toml_project"
    },
    {
      "path": "app/PhotoCenterMenuBar/Info.plist",
      "kind": "plist_bundle"
    }
  ]
}
